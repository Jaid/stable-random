{
  "name": "stable-random",
  "version": "0.0.1",
  "type": "module",
  "description": "Deterministic random rolls keyed by a seed, a chain of IDs and an index, independent of call order.",
  "keywords": ["deterministic", "prng", "procedural-generation", "random", "seeded"],
  "funding": "https://github.com/sponsors/Jaid",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jaid/stable-random.git"
  },
  "exports": {
    ".": {
      "default": "./src/main.ts"
    }
  },
  "scripts": {
    "build": "bun run readme && bundil",
    "lint": "eslint . --max-warnings 0",
    "readme": "bun tldw",
    "test": "bun test --max-concurrency 1 ./test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "bundil": "0.1.0",
    "eslint": "10.15.0",
    "eslint-config-jaid": "37.1.0",
    "tldw": "9.9.0",
    "tsconfig-jaid-bun": "16.0.0",
    "typescript": "npm:typescript-classic@6.0.4",
    "@types/bun": "1.4.5"
  },
  "sideEffects": false
}
